---
import ErrorCard from './ErrorCard.astro';
import type { ErrorEntry } from '@/lib/errors';

interface Props {
  category: 'informational' | 'success' | 'redirection' | 'client' | 'server';
  entries: ErrorEntry[];
}
const { category, entries } = Astro.props;
const headings: Record<string, string> = {
  client: '4xx — Client Errors（クライアント側のつまずき）',
  server: '5xx — Server Errors（サーバー側のつまずき）',
  informational: '1xx — Informational（校庭：朝礼の合図）',
  success: '2xx — Success（プール：達成の証）',
  redirection: '3xx — Redirection（渡り廊下：別の場所へ）',
};
const heading = headings[category] ?? category;
---
<section class="my-12">
  <h2 class="text-2xl font-[Finger_Paint] chalk-text-amber mb-6 chalk-underline">
    {heading}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {entries.map(e => <ErrorCard entry={e} />)}
  </div>
</section>
